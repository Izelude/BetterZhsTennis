{
  "name": "better-zhstennis",
  "version": "0.1.1",
  "private": false,
  "description": "TypeScript Node backend that serves a React hello world page.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "better-zhstennis": "dist/cli.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "dev": "vite",
    "dev:backend": "tsx watch src/cli.ts",
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build",
    "build:server": "tsup",
    "start": "node dist/cli.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "express": "^4.19.2",
    "luxon": "^3.7.0",
    "open": "^10.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.21",
    "@types/luxon": "^3.7.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^5.6.0"
  }
}